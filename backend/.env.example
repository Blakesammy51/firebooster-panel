APP_NAME=Firebooster
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Firebooster"

# Paystack (leave blank until test-mode setup is complete)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_MINIMUM_DEPOSIT_KOBO=10000
PAYSTACK_MAXIMUM_DEPOSIT_KOBO=100000000

# SMM Center provider (set only in the hosting provider's private environment settings)
SMM_CENTER_API_KEY=
SMM_CENTER_BASE_URL=https://smm-center.com
